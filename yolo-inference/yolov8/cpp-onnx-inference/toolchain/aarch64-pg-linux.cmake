set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

set(CMAKE_SYSROOT $ENV{SDKTARGETSYSROOT})

set(TOOLCHAIN_FLAGS "")
set(TOOLCHAIN_FLAGS "${TOOLCHAIN_FLAGS} -pthread")
set(TOOLCHAIN_FLAGS "${TOOLCHAIN_FLAGS} -mcpu=cortex-a53")
set(TOOLCHAIN_FLAGS "${TOOLCHAIN_FLAGS} -march=armv8-a")
set(TOOLCHAIN_FLAGS "${TOOLCHAIN_FLAGS} -ffast-math")
set(TOOLCHAIN_FLAGS "${TOOLCHAIN_FLAGS} -ftree-vectorize")

set(CMAKE_C_COMPILER aarch64-pg-linux-gcc)
set(CMAKE_CXX_COMPILER aarch64-pg-linux-g++)

set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} ${TOOLCHAIN_FLAGS}" CACHE STRING "")
set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} ${TOOLCHAIN_FLAGS}" CACHE STRING "")

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
